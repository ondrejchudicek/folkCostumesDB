{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test:unit": "vitest run --config ./vitest.config.unit.ts",
    "test:unit:watch": "vitest --config ./vitest.config.unit.ts",
    "test:component": "vitest run --config ./vitest.config.component.ts",
    "test:component:watch": "vitest --ui --config ./vitest.config.component.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config ./vitest.config.e2e.ts",
    "test": "npm run test:unit && npm run test:component",
    "test:watch": "npm run test:unit:watch && npm run test:component:watch",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
